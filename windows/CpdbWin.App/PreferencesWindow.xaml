<Window x:Class="CpdbWin.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14" MinWidth="440">
        <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Global hotkey" FontWeight="SemiBold"/>
            <TextBox x:Name="HotkeyBox"
                     IsReadOnly="True"
                     PlaceholderText="Click and press your combo…"
                     GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus"
                     KeyDown="HotkeyBox_KeyDown"/>
            <TextBlock x:Name="HotkeyHint"
                       FontSize="11"
                       Opacity="0.6"
                       Text="Pick a modifier (Ctrl / Alt / Shift / Win) plus a regular key. Win+V is owned by Windows clipboard history; pick something else."/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Import / Export" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        x:Name="ImportButton"
                        Content="Import URLs…"
                        Click="ImportUrls_Click"/>
                <ComboBox Grid.Column="1"
                          x:Name="ExportFormatBox"
                          SelectedIndex="0"
                          MinWidth="84">
                    <ComboBoxItem Content="Markdown" Tag="md"/>
                    <ComboBoxItem Content="CSV"      Tag="csv"/>
                    <ComboBoxItem Content="HTML"     Tag="html"/>
                </ComboBox>
                <Button Grid.Column="2"
                        x:Name="ExportButton"
                        Content="Export history…"
                        HorizontalAlignment="Left"
                        Click="ExportHistory_Click"/>
            </Grid>
            <TextBlock x:Name="PortabilityStatus"
                       FontSize="11"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Text="Import: one URL per line (http/https/file; blank + #-comment lines skipped). Export: metadata + text only, newest-first."/>
        </StackPanel>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Reset to default" Click="Reset_Click"/>
            <Button Grid.Column="2" Content="Cancel"           Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Save"             Click="Save_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
