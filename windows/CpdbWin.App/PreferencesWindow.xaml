<Window x:Class="CpdbWin.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="14" MinWidth="480">
        <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">

                <!-- Global hotkey -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Global hotkey" FontWeight="SemiBold"/>
                    <TextBox x:Name="HotkeyBox"
                             IsReadOnly="True"
                             PlaceholderText="Click and press your combo…"
                             GotFocus="HotkeyBox_GotFocus"
                             LostFocus="HotkeyBox_LostFocus"
                             KeyDown="HotkeyBox_KeyDown"/>
                    <TextBlock x:Name="HotkeyHint"
                               FontSize="11"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Text="Pick a modifier (Ctrl / Alt / Shift / Win) plus a regular key. Win+V is owned by Windows clipboard history; pick something else."/>
                </StackPanel>

                <!-- Startup -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Startup" FontWeight="SemiBold"/>
                    <CheckBox x:Name="StartupCheck"
                              Content="Launch cpdb-win at login"
                              Click="StartupCheck_Click"/>
                    <TextBlock x:Name="StartupHint"
                               FontSize="11"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Text="Re-launches cpdb-win on every login so clipboard capture is always running."/>
                </StackPanel>

                <!-- Library maintenance -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Library maintenance" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="ReEnrichButton"
                                Content="Re-enrich now"
                                Click="ReEnrich_Click"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <Button Grid.Column="1" x:Name="ReclassifyButton"
                                Content="Reclassify kinds"
                                Click="Reclassify_Click"/>
                        <Button Grid.Column="2" x:Name="RetryEmptyButton"
                                Content="Retry empty titles"
                                Click="RetryEmpty_Click"/>
                        <Button Grid.Column="3" x:Name="ReOcrButton"
                                Content="Re-OCR images"
                                ToolTipService.ToolTip="Re-run text recognition only; existing classifier tags are kept"
                                Click="ReOcr_Click"/>
                        <Button Grid.Column="4" x:Name="ReTagButton"
                                Content="Re-tag images"
                                ToolTipService.ToolTip="Re-run the image classifier only; existing OCR text is kept"
                                Click="ReTag_Click"/>
                    </Grid>
                    <TextBlock x:Name="MaintenanceStatus"
                               FontSize="11"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Text="Re-enrich now = reclassify URL-shaped text into links, then queue a link-title/thumbnail refetch for entries missing a title (e.g. after a restore). The backfill loop fetches them in the background."/>
                </StackPanel>

                <!-- Import / Export -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Import / Export" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                x:Name="ImportButton"
                                Content="Import URLs…"
                                Click="ImportUrls_Click"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="ExportFormatBox"
                                  SelectedIndex="0"
                                  MinWidth="84">
                            <ComboBoxItem Content="Markdown" Tag="md"/>
                            <ComboBoxItem Content="CSV"      Tag="csv"/>
                            <ComboBoxItem Content="HTML"     Tag="html"/>
                        </ComboBox>
                        <Button Grid.Column="2"
                                x:Name="ExportButton"
                                Content="Export history…"
                                HorizontalAlignment="Left"
                                Click="ExportHistory_Click"/>
                    </Grid>
                    <TextBlock x:Name="PortabilityStatus"
                               FontSize="11"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               Text="Import: one URL per line (http/https/file; blank + #-comment lines skipped). Export: metadata + text only, newest-first."/>
                </StackPanel>

                <!-- Storage -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Storage" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StorageInfo"
                               FontSize="12"
                               Opacity="0.8"
                               IsTextSelectionEnabled="True"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="Reading…"/>
                </StackPanel>

                <!-- Updates -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Updates" FontWeight="SemiBold"/>
                    <Button x:Name="CheckUpdatesButton"
                            Content="Check for Updates…"
                            HorizontalAlignment="Left"
                            Click="CheckUpdates_Click"/>
                    <TextBlock x:Name="UpdatesInfo"
                               FontSize="11"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Reset hotkey" Click="Reset_Click"/>
            <Button Grid.Column="2" Content="Cancel"        Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Save"          Click="Save_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
