<Window x:Class="CpdbWin.App.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Black">
        <!-- Dark chrome — the Mac QL panel is neutral-dark and the
             preview reads best against near-black. ScrollViewer only
             kicks in when the image is larger than the window; images
             smaller than that get centered by the parent Grid. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.1"
                      MaxZoomFactor="4">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Overlay hint bar at the bottom — Escape/Space to close.
             Faded so it doesn't distract from the image, but present
             so a first-time user knows how to dismiss without
             hunting for the OS chrome (there might not be any if
             the user is running the app maximised). -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Background="#80000000"
                CornerRadius="6"
                Padding="10,4"
                Margin="0,0,0,16">
            <TextBlock Text="Esc or Space to close"
                       Foreground="#B0FFFFFF"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>
