<Window x:Class="CpdbWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CpdbWin.App">
    <Grid Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search clipboard history…"
                     TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="KindFilter"
                      Grid.Column="1"
                      Width="120"
                      SelectedIndex="0"
                      SelectionChanged="KindFilter_SelectionChanged">
                <ComboBoxItem Content="All"   Tag=""/>
                <ComboBoxItem Content="Text"  Tag="text"/>
                <ComboBoxItem Content="Link"  Tag="link"/>
                <ComboBoxItem Content="Image" Tag="image"/>
                <ComboBoxItem Content="File"  Tag="file"/>
                <ComboBoxItem Content="Color" Tag="color"/>
                <ComboBoxItem Content="Other" Tag="other"/>
            </ComboBox>
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings (Import / Export, hotkey, updates)"
                    AutomationProperties.Name="Settings">
                <SymbolIcon Symbol="Setting"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <ListView x:Name="EntryList"
                      Grid.Column="0"
                      SelectionChanged="EntryList_SelectionChanged"
                      DoubleTapped="EntryList_DoubleTapped"
                      SelectionMode="Extended">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EntryViewModel">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10" Margin="0,4"
                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind PinMenuLabel}" Click="PinMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Pin"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Delete" Click="DeleteMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Border Width="48" Height="48"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <SymbolIcon Grid.Column="2"
                                        Symbol="Pin"
                                        Width="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind PinGlyphVisibility}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="12">
                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                    <Grid Grid.Row="0">
                        <ScrollViewer x:Name="DetailTextScroll" Visibility="Collapsed">
                            <TextBlock x:Name="DetailText"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="Consolas"/>
                        </ScrollViewer>
                        <Image x:Name="DetailImage" Visibility="Collapsed" Stretch="Uniform"/>
                        <!-- Link entries: stacked title / thumbnail / URL.
                             Used when the selected row is kind=link.
                             Title gets prominence at the top; the og:image
                             thumbnail (Stage D) sits centered; the URL is
                             a clickable HyperlinkButton at the bottom. -->
                        <ScrollViewer x:Name="DetailLinkScroll"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10" Padding="2">
                                <TextBlock x:Name="DetailLinkTitle"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"/>
                                <Image x:Name="DetailLinkImage"
                                       Visibility="Collapsed"
                                       MaxHeight="320"
                                       HorizontalAlignment="Center"
                                       Stretch="Uniform"/>
                                <HyperlinkButton x:Name="DetailLinkUrl"
                                                 FontSize="12"
                                                 Padding="0"/>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="DetailEmpty"
                                   Text="Select an entry to preview"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="DetailMeta" Grid.Row="1" Visibility="Collapsed" Spacing="2">
                        <HyperlinkButton x:Name="DetailSourceUrl"
                                         Visibility="Collapsed"
                                         Padding="0"
                                         FontSize="12"/>
                        <HyperlinkButton x:Name="DetailPageUrl"
                                         Visibility="Collapsed"
                                         Padding="0"
                                         FontSize="12"/>
                        <TextBlock x:Name="DetailHtmlNote"
                                   Visibility="Collapsed"
                                   Opacity="0.6"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="StatusText" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="FooterText" Grid.Column="1" Opacity="0.4" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
